    "lib/types/**/*.d.ts",
    "data/quran-uthmani.txt",
    "data/quran-uthmani.sha256",
    "data/quran-simple-clean.txt",
    "data/quran-simple-clean.sha256"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/dsh-quran-evidence": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
