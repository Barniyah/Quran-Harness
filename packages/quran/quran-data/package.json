{
  "name": "@deepseek-ai/dsh-quran-data",
  "description": "Pinned, integrity-checked Tanzil Uthmani Quran text artifact and loaders — the single data owner for Quran text capabilities",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
