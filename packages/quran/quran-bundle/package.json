{
  "name": "@deepseek-ai/dsh-quran-bundle",
  "description": "Quran Harness bundle: evidence-governed Quran tools and the Quran agent preset",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-quran-evidence": "workspace:*",
    "@deepseek-ai/dsh-quran-sdk": "workspace:*",
    "@deepseek-ai/dsh-skill-quran": "workspace:*",
    "@deepseek-ai/dsh-tool-quran-text": "workspace:*",
    "@deepseek-ai/dsh-tool-quran-metadata": "workspace:*"
  }
}
