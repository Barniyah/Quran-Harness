{
  "name": "@deepseek-ai/dsh-quran-sdk",
  "description": "TypeScript developer SDK for building evidence-governed Quranic applications and research pipelines",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-quran-data": "workspace:*",
    "@deepseek-ai/dsh-quran-evidence": "workspace:*",
    "@deepseek-ai/dsh-tool-mushaf-layout": "workspace:*",
    "@deepseek-ai/dsh-tool-quran-audio": "workspace:*",
    "@deepseek-ai/dsh-tool-quran-linguistics": "workspace:*",
    "@deepseek-ai/dsh-tool-quran-metadata": "workspace:*",
    "@deepseek-ai/dsh-tool-quran-riwayat": "workspace:*",
    "@deepseek-ai/dsh-tool-quran-search": "workspace:*",
    "@deepseek-ai/dsh-tool-quran-text": "workspace:*",
    "quran-meta": "^7.0.0"
  }
}
